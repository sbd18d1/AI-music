# ============================================
# 数据库配置
# ============================================
# Turso libSQL 数据库连接
# 标准格式：TURSO_DATABASE_URL（不含 authToken） + TURSO_AUTH_TOKEN（单独的 token）
TURSO_DATABASE_URL="libsql://your-database-url.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"
# 兼容旧格式：DATABASE_URL（包含 authToken）
DATABASE_URL="libsql://your-database-url.turso.io?authToken=your_token_here"

# ============================================
# 302.ai Suno API 配置
# ============================================
# 302.ai API 密钥（用于调用 Suno 音乐生成接口）
THREE02_AI_KEY=your_302_ai_key_here
# 302.ai API 基础地址
# - 海外用户：https://api.302.ai
# - 国内用户：https://api.302api.com
THREE02_AI_BASE_URL=https://api.302.ai
# AI 生成模式："mock"（测试模式）或 "real"（正式模式）
NEXT_PUBLIC_AI_GENERATION_MODE=mock

# ============================================
# Resend 邮件配置
# ============================================
# Resend API 密钥
RESEND_API_KEY=your_resend_api_key_here
# 发送邮件的发件人地址
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# 应用配置
# ============================================
# 应用的公共 URL（用于支付回调和邮件链接）
NEXT_PUBLIC_URL=http://localhost:3000

# ============================================
# 支付渠道配置
# ============================================
# 支付渠道：paypal
NEXT_PUBLIC_PAYMENT_PROVIDER=paypal

# ============================================
# 主题配置
# ============================================
# 网站主题："warmRetro"（美式温暖复古风）或 "modern"（现代深色风）
NEXT_PUBLIC_THEME=vintageWarm

# ============================================
# PayPal 支付配置
# ============================================
# PayPal 模式：sandbox（测试）或 live（生产）
# - sandbox: 使用 PayPal sandbox 测试账号，不扣真实款项
# - live:    使用 PayPal live 账号，扣真实款项
# 切换此值会同时控制：后端 API（create/capture/webhook）的凭据选择，
# 以及前端 SDK 加载的 Client ID（通过 NEXT_PUBLIC_PAYPAL_MODE 保持一致）。
PAYPAL_MODE=sandbox
# 前端也需要知道当前模式（Next.js 客户端组件只能读到 NEXT_PUBLIC_ 前缀变量）
# 切换环境时请保持与 PAYPAL_MODE 一致
NEXT_PUBLIC_PAYPAL_MODE=sandbox

# ============================================
# 测试环境（sandbox）凭据
# 在 PayPal Developer Dashboard → My Apps → Sandbox App 中获取
# ============================================
# 前端 SDK 公钥（浏览器可见），仅 sandbox 测试时使用
NEXT_PUBLIC_PAYPAL_CLIENT_ID_SANDBOX=your_paypal_sandbox_client_id_here
# 后端凭据（sandbox）
PAYPAL_CLIENT_ID_SANDBOX=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET_SANDBOX=your_paypal_sandbox_secret_here
# sandbox webhook 签名校验 ID（可选，测试环境建议配置）
PAYPAL_WEBHOOK_ID_SANDBOX=

# ============================================
# 正式环境（live）凭据
# 在 PayPal Developer Dashboard → My Apps → Live App 中获取
# ============================================
# 前端 SDK 公钥（浏览器可见），正式支付时使用
NEXT_PUBLIC_PAYPAL_CLIENT_ID_LIVE=your_paypal_live_client_id_here
# 后端凭据（live）
PAYPAL_CLIENT_ID_LIVE=your_paypal_live_client_id_here
PAYPAL_CLIENT_SECRET_LIVE=your_paypal_live_secret_here
# live webhook 签名校验 ID（生产环境强烈建议配置）
PAYPAL_WEBHOOK_ID_LIVE=your_paypal_live_webhook_id_here

# ============================================
# PayPal Webhook URL（需要在 PayPal Developer Dashboard 中配置）
# ============================================
# Sandbox: 通过 webhook.site 或 ngrok 转发到本地 http://localhost:3000/api/webhook/paypal
# Production: https://www.smartmusiclab.com/api/webhook/paypal

# ============================================
# 交付模式配置
# ============================================
# 交付模式："INSTANT"（极简即时交付）或 "SESSION_LOCK"（设备记忆锁死）
NEXT_PUBLIC_DELIVERY_MODE=INSTANT