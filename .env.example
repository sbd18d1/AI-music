# ============================================
# 数据库配置
# ============================================
# Turso libSQL 数据库连接
# 标准格式：TURSO_DATABASE_URL（不含 authToken） + TURSO_AUTH_TOKEN（单独的 token）
TURSO_DATABASE_URL="libsql://your-database-url.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"
# 兼容旧格式：DATABASE_URL（包含 authToken）
DATABASE_URL="libsql://your-database-url.turso.io?authToken=your_token_here"

# ============================================
# 302.ai Suno API 配置
# ============================================
# 302.ai API 密钥（用于调用 Suno 音乐生成接口）
THREE02_AI_KEY=your_302_ai_key_here
# 302.ai API 基础地址
# - 海外用户：https://api.302.ai
# - 国内用户：https://api.302api.com
THREE02_AI_BASE_URL=https://api.302.ai
# AI 生成模式："mock"（测试模式）或 "real"（正式模式）
NEXT_PUBLIC_AI_GENERATION_MODE=mock

# ============================================
# Resend 邮件配置
# ============================================
# Resend API 密钥
RESEND_API_KEY=your_resend_api_key_here
# 发送邮件的发件人地址
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# 应用配置
# ============================================
# 应用的公共 URL（用于支付回调和邮件链接）
NEXT_PUBLIC_URL=http://localhost:3000

# ============================================
# 支付渠道配置（已统一为 Paddle）
# ============================================
# 支付渠道：paddle（Paddle 统一收银台，支持 Apple Pay / Google Pay / Credit Card / PayPal 托管）
NEXT_PUBLIC_PAYMENT_PROVIDER=paddle

# ============================================
# Paddle 统一支付配置
# ============================================
# Paddle 客户端 Token（前端使用）
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="pdl_client_tok_your_token_here"
# Paddle 环境：sandbox（测试）或 live（生产）
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
# Paddle 服务端 API Key
PADDLE_API_KEY="pdl_api_your_api_key_here"
# Paddle Webhook 签名密钥
PADDLE_WEBHOOK_SECRET_KEY="pdl_ntf_your_webhook_secret_here"
# Paddle 商品 Price ID
NEXT_PUBLIC_PADDLE_PRICE_ID="pri_your_price_id_here"

# ============================================
# 主题配置
# ============================================
# 网站主题："warmRetro"（美式温暖复古风）或 "modern"（现代深色风）
NEXT_PUBLIC_THEME=vintageWarm

# ============================================
# 交付模式配置
# ============================================
# 交付模式："INSTANT"（极简即时交付）或 "SESSION_LOCK"（设备记忆锁死）
NEXT_PUBLIC_DELIVERY_MODE=INSTANT