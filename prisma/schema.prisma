generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Order {
  id                 String    @id @default(uuid())
  recipientName      String
  personality        String
  genre              String
  userEmail          String?
  customerEmail      String?
  selectedStyle      String?
  selectedArtistStyle String?
  songConfig         String?
  status             String    @default("pending")
  paymentOrderId     String?    @map("paypalOrderId")
  aiRequestId        String?
  audioUrl           String?
  lyrics             String?
  title              String?
  coverImageUrl      String?
  duration           String?
  isFullVersion      Boolean @default(false)
  ipAddress          String?
  deviceId           String?
  trialOrderId       String?
  couponCode         String?   // internal code of the coupon auto-applied to this order (audit)
  emailSentAt        DateTime? // set once the song email has been delivered (idempotency)
  amountPaid         Float?    // actual captured amount (0 when a coupon fully covered it)
  currency           String?   // ISO currency of amountPaid, e.g. "USD"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([paymentOrderId])
  @@index([aiRequestId])
  @@index([status])
  @@index([ipAddress])
  @@index([deviceId])
  @@index([trialOrderId])
}

model TrialUsage {
  id        String    @id @default(uuid())
  ipAddress String?
  deviceId  String?
  usedAt    DateTime  @default(now())

  @@index([ipAddress])
  @@index([deviceId])
  @@index([usedAt])
}

// First-party analytics. One narrow table serving BOTH page views and named
// click/conversion beacons, so a single GROUP BY can produce per-path funnels.
// Geo is country/city/region only, resolved from Vercel's request headers at write
// time. Raw IP is intentionally NOT stored here (see Order.ipAddress).
model Visit {
  id          String   @id @default(uuid())
  type        String   @default("pageview") // pageview | trial_start | checkout_start | share | download
  path        String
  referrer    String?  // normalized host only, e.g. "google.com"
  host        String?
  country     String?  // ISO-3166 alpha-2 from x-vercel-ip-country
  region      String?  // from x-vercel-ip-country-region
  city        String?  // from x-vercel-ip-city (URL-encoded by Vercel)
  deviceId    String?  // getDeviceId() fingerprint, links Visit <-> Order.deviceId
  sessionId   String?  // random per-tab id, sessionizes the log
  isBot       Boolean  @default(false)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([path])
  @@index([sessionId])
  @@index([country])
}

model SongConfigDimension {
  id        String               @id @default(uuid())
  dimensionId String             @unique
  title     String
  subtitle  String?
  sortOrder Int                  @default(0)
  options   SongConfigOption[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([dimensionId])
  @@index([sortOrder])
}

model SongConfigOption {
  id              String               @id @default(uuid())
  optionId        String               @unique
  dimensionId     String
  dimension       SongConfigDimension  @relation(fields: [dimensionId], references: [dimensionId], onDelete: Cascade)
  icon            String
  name            String
  description     String
  styleTag        String?
  lyricInstruction String?
  genreValue      String?
  keywords        String?
  sortOrder       Int                  @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([dimensionId])
  @@index([optionId])
  @@index([sortOrder])
}

// One-time free-song coupon. A user earns one per paid order by sharing their
// completed song; it fully covers one brand-new full song (bypassing PayPal).
// Single-use: `used` flips atomically on redeem and the consuming browser
// fingerprint + IP + timestamp are recorded for anti-replay auditing.
model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique            // user-facing redemption code, e.g. "SHARE-XXXXXX"
  value           Float     @default(1.00)     // face value = one full song's price
  currency        String    @default("USD")
  issuedByOrderId String?                       // the paid order whose share earned this coupon
  issuedByDeviceId String?                      // fingerprint that claimed the coupon
  issuedAt        DateTime  @default(now())
  used            Boolean   @default(false)
  usedByDeviceId  String?                       // fingerprint that redeemed it
  usedIp          String?
  usedAt          DateTime?
  usedForOrderId  String?                       // the order the coupon paid for
  createdAt       DateTime  @default(now())

  @@index([issuedByOrderId])
  @@index([issuedByDeviceId])
  @@index([used])
}
